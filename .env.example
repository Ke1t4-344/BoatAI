# BoatAI 環境変数テンプレート
# このファイルをコピーして .env を作成し、実際の値を入力してください
# .env は git にコミットしないこと（.gitignore に追加済み）

# Turso DB 接続情報
# turso db show boatai で URL を確認
TURSO_URL=libsql://boatai-XXXXXX.aws-ap-northeast-1.turso.io
# turso db tokens create boatai でトークンを取得
TURSO_TOKEN=

# Streamlit 認証（ログイン画面のパスワード設定）
# 英数字・記号が使えます
AUTH_PASSWORD=

# Railway デプロイ時は上記を Railway の環境変数画面で設定してください
