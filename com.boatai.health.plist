<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.boatai.health</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/miyoshikeita/miniconda3/envs/boatai/bin/python3</string>
        <string>/Users/miyoshikeita/boatai/health_check.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/miyoshikeita/boatai</string>

    <!-- 毎朝9:00に実行（morning_scraper完了後、scraper.py初回完了後のタイミング） -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/miyoshikeita/boatai/logs/health_check.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/miyoshikeita/boatai/logs/health_check.log</string>
</dict>
</plist>
